{
  "name": "simple-budget-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:spa",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:spa": "vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "verify:gates": "node scripts/verify-build-gates.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
